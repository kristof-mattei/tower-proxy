{
    "name": "tower-proxy",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt"
    },
    "devDependencies": {
        "cspell": "10.4.0",
        "oxfmt": "0.74.0"
    },
    "engines": {
        "node": "26.12.0"
    },
    "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
