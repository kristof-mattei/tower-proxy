{
    "name": "tower-proxy",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt"
    },
    "devDependencies": {
        "cspell": "10.3.6",
        "oxfmt": "0.71.0"
    },
    "engines": {
        "node": "26.10.0"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
