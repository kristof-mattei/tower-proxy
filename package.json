{
    "name": "tower-proxy",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt"
    },
    "devDependencies": {
        "cspell": "10.3.6",
        "oxfmt": "0.72.0"
    },
    "engines": {
        "node": "26.10.0"
    },
    "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
